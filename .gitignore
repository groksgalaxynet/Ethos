# Evidence is ignored by default. Generated runtime material stays excluded.
/evidence/*
!/evidence/
/evidence/*runtime*/
/evidence/*live*/
/evidence/*smoke*/
/evidence/*evaluation*/
/evidence/*/disposable-target/
/evidence/*/target/

